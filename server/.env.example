# 臻品足道荣辱榜 - 环境变量配置
# 复制此文件为 .env 并填写实际值

# 服务器端口（默认 3000）
PORT=3000

# 邮箱配置（用于发送验证码）
# 邮箱账号
EMAIL_USER=13972601452@139.com
# 邮箱授权码（不是登录密码，需要在邮箱设置中获取）
EMAIL_PASS=your_email_password_here
# SMTP 服务器地址
EMAIL_SMTP_HOST=smtp.139.com
# SMTP 端口（SSL 通常为 465）
EMAIL_SMTP_PORT=465

# JWT 密钥（用于用户认证，建议修改为随机字符串）
JWT_SECRET=your_jwt_secret_key_here

# 数据库路径（默认不需要修改）
DB_PATH=./server/database/rongrubi.db
